# Copy to `.env` for local development. `.env` is gitignored — never commit it.
# In production these are set in the Vercel dashboard (Settings → Environment
# Variables), not in this repo.
#
# All three are read ONLY server-side, inside src/pages/api/agent.ts. None of
# them may be referenced from a component or any other file under src/ —
# Astro frontmatter runs at build time, so anything it touches is baked into
# the shipped HTML and readable by scrapers.

# https://console.anthropic.com/settings/keys
# Also set a monthly spend limit in the Console. The agent endpoint is public
# and unauthenticated, so that limit is the only cost control a bug in this
# repo cannot bypass.
ANTHROPIC_API_KEY=

# https://resend.com/api-keys
RESEND_API_KEY=

# Where contact messages are delivered. This is the address the whole design
# exists to keep off the page — it must never appear anywhere else in the repo.
CONTACT_EMAIL=

# Optional. The verified Resend sending identity; defaults to
# agent@jarrettheflin.com. The domain must be verified in Resend before any
# mail will send.
AGENT_FROM_EMAIL=
