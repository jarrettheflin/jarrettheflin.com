---
import { SITE, LINKS } from '../consts';
---

<header class="hero container">
	{/* The name is the h1: on a personal site it's the most important heading
	    for both search and screen readers. The two descriptor lines follow it,
	    the second dimmed so the block reads as name → what → how. */}
	<h1 class="hero__headline">
		{SITE.name}<br />
		<span class="hero__headline-sub">Growth, Brand, Product Marketing</span><br
		/>
		<span class="hero__headline-dim">Camera in hand</span>
	</h1>

	<p class="hero__lede">
		I write the stories and systems that get products to the right people.
	</p>

	<nav class="hero__links" aria-label="Contact and profiles">
		{
			LINKS.map((link) => (
				<a class="hero__link" href={link.href}>
					{link.label}
				</a>
			))
		}
	</nav>
</header>

<style>
	.hero {
		padding-top: clamp(var(--s-7), 10vh, var(--s-9));
		padding-bottom: var(--s-section);
	}

	.hero__headline {
		/* Wide enough that "Growth, Brand, Product Marketing" doesn't wrap at
		   desktop sizes — it reads as one line or not at all. */
		max-width: 28ch;
		/* balance would even out the three lines and fight the deliberate
		   stepped structure. */
		text-wrap: initial;
	}

	/* The descriptor lines step down in weight and size so the name stays the
	   anchor and the block reads name → what → how. */
	.hero__headline-sub {
		font-size: clamp(1.5rem, 1rem + 2.2vw, 2.75rem);
		font-weight: var(--w-medium);
		letter-spacing: var(--tr-normal);
	}

	.hero__headline-dim {
		font-size: clamp(1.5rem, 1rem + 2.2vw, 2.75rem);
		font-weight: var(--w-normal);
		letter-spacing: var(--tr-normal);
		color: var(--c-ink-faint);
	}

	.hero__lede {
		max-width: var(--measure);
		margin-top: var(--s-6);
		font-size: var(--t-md);
		line-height: var(--lh-loose);
		color: var(--c-ink-muted);
	}

	.hero__links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-2) var(--s-5);
		margin-top: var(--s-6);
	}

	.hero__link {
		font-family: var(--f-mono);
		font-size: var(--t-xs);
		letter-spacing: var(--tr-wide);
		text-transform: uppercase;
		text-decoration: none;
		padding-bottom: 2px;
		border-bottom: var(--hairline) solid var(--c-rule-strong);
	}

	.hero__link:hover {
		border-bottom-color: var(--c-accent);
	}
</style>
