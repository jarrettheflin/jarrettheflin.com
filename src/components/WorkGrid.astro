---
import { getWorkEntries } from '../lib/work';
import type { WorkEntry } from '../lib/work';
import WorkCard from './WorkCard.astro';

/**
 * The flat, unanimated index of every project — now the body of `/projects/`.
 *
 * The homepage uses WorkStack.astro instead. This grid stays because it is the
 * canonical keyboard and screen-reader path to the full list: in the stack, a
 * card buried three deep is `visibility: hidden` and so can't be reached by
 * forward tabbing. It is also the only place a visitor can see all the work at
 * once without nine viewports of scrolling.
 *
 * Adding a project means dropping a markdown file into src/content/work/ —
 * this component needs no edit.
 */
interface Props {
	/** Shown as the section label. */
	heading?: string;
}

const { heading = 'Selected projects' } = Astro.props;

const sorted = await getWorkEntries();
---

<section class="work container" id="projects" aria-labelledby="projects-heading">
	<div class="section-label">
		<h2 class="meta work__label" id="projects-heading">{heading}</h2>
		<span class="meta work__count">{sorted.length}</span>
	</div>

	{
		sorted.length === 0 ? (
			<p class="work__empty">
				Nothing published yet. Add a markdown file to
				<code>src/content/work/</code> and it will appear here.
			</p>
		) : (
			<div class="work__grid">
				{sorted.map((entry: WorkEntry, i: number) => (
					<WorkCard entry={entry} emphasis={i < 2} />
				))}
			</div>
		)
	}
</section>

<style>
	.work {
		padding-bottom: var(--s-section);
		scroll-margin-top: var(--s-6);
	}

	/* The h2 is styled as a small label rather than a display heading — the
	   hero already carries the page's typographic weight. */
	.work__label {
		font-size: var(--t-xs);
		font-weight: var(--w-normal);
		letter-spacing: var(--tr-wide);
		color: var(--c-ink);
		margin-right: auto;
	}

	.work__grid {
		display: grid;
		gap: var(--s-8) var(--s-6);
		grid-template-columns: 1fr;
	}

	@media (min-width: 48rem) {
		.work__grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	.work__empty {
		color: var(--c-ink-muted);
	}

	.work__empty code {
		font-family: var(--f-mono);
		font-size: 0.9em;
	}
</style>
