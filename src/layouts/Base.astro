---
import '../styles/global.css';
import { SITE } from '../consts';

interface Props {
	/** Page title, without the site-name suffix. Omit on the homepage. */
	title?: string;
	description?: string;
	/** Absolute or root-relative path to a social preview image. */
	image?: string | null;
	/** Set true on project pages so search engines treat them as articles. */
	article?: boolean;
}

const {
	title,
	description = SITE.description,
	image = SITE.ogImage,
	article = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE.titleSuffix}` : SITE.name;

// Astro.site comes from `site` in astro.config.mjs; these resolve to absolute
// URLs, which social platforms require.
const canonical = new URL(Astro.url.pathname, Astro.site);

// Only emit image meta tags when there's actually an image. A tag pointing at
// a missing file makes several platforms render a broken or blank card, which
// is worse than letting them fall back to title + description.
const socialImage = image ? new URL(image, Astro.site) : null;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />

		{/* The headline is the largest thing on the page and the most visibly
		    affected by a font swap, so the one variable file is preloaded.
		    `crossorigin` is required even same-origin: fonts are always fetched
		    in CORS mode, and without it the preload is discarded and refetched. */}
		<link
			rel="preload"
			href="/fonts/figtree-latin-var.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>

		{/* Jarrett's JH mark, from jarrettheflin-tab-logo.png in the vault.
		    One flat artwork at several sizes: it replaced a theme-reactive SVG
		    favicon, so the tab icon is now the same mark in light and dark
		    chrome — which is the point of a logo. 32px is the tab itself;
		    the larger two are for bookmarks, home screens and install
		    prompts, which upscale a 32px source into mush. */}
		<link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
		<link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
		<link rel="icon" href="/icon-512.png" type="image/png" sizes="512x512" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<!-- Open Graph -->
		<meta property="og:type" content={article ? 'article' : 'website'} />
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		{
			socialImage && (
				<>
					<meta property="og:image" content={socialImage} />
					<meta property="og:image:width" content="1200" />
					<meta property="og:image:height" content="630" />
				</>
			)
		}

		<!-- Twitter / X -->
		{/* summary_large_image needs an image; without one, `summary` is the
		    correct card type and renders a clean text preview. */}
		<meta
			name="twitter:card"
			content={socialImage ? 'summary_large_image' : 'summary'}
		/>
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		{socialImage && <meta name="twitter:image" content={socialImage} />}

		<!-- Matches the token palette so browser chrome doesn't clash. -->
		<meta name="theme-color" content="#121113" />
	</head>

	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<slot />
	</body>
</html>
