---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import { getWorkEntries } from '../../lib/work';
import type { WorkEntry } from '../../lib/work';

/**
 * Generates one page per markdown file in src/content/work/.
 * Adding a project never requires touching this file.
 *
 * The draft filter lives in src/lib/work.ts, shared with the homepage stack and
 * the /work/ index — so a project can never be listed somewhere it wasn't
 * actually built.
 */
export async function getStaticPaths() {
	const entries = await getWorkEntries();

	return entries.map((entry: WorkEntry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

interface Props {
	entry: WorkEntry;
}

const { entry } = Astro.props;
const { title, blurb, year, role, tags, thumbnail, video, coverVideo, link } =
	entry.data;

// The markdown body below the frontmatter becomes the write-up.
const { Content } = await render(entry);
---

<Base
	title={title}
	description={blurb}
	article
	image={thumbnail?.src}
>
	<main id="main" class="project">
		<div class="container">
			<p class="meta project__back">
				<a href="/#work">← All work</a>
			</p>

			<header class="project__header">
				<h1 class="project__title">{title}</h1>
				<p class="project__blurb">{blurb}</p>

				<dl class="project__facts">
					{
						year && (
							<div class="project__fact">
								<dt class="meta">Year</dt>
								<dd>{year}</dd>
							</div>
						)
					}
					<div class="project__fact">
						<dt class="meta">Role</dt>
						<dd>{role}</dd>
					</div>
					{
						tags.length > 0 && (
							<div class="project__fact">
								<dt class="meta">Tags</dt>
								<dd>{tags.join(', ')}</dd>
							</div>
						)
					}
				</dl>
			</header>

			<div class="project__media">
				{
					video ? (
						<VideoEmbed url={video} title={title} />
					) : coverVideo && coverVideo.length > 0 ? (
						/* No full-length embed yet, but there's a cover loop — show
						   that rather than a still. Better than nothing, and it
						   upgrades to the real embed the moment `video` is set. */
						<div class="project__cover">
							<VideoEmbed
								mode="cover"
								sources={coverVideo}
								poster={thumbnail}
								title={title}
							/>
						</div>
					) : (
						thumbnail && (
							<Image
								class="project__image"
								src={thumbnail}
								alt={`${title} — still`}
								widths={[640, 1024, 1600]}
								sizes="(min-width: 72rem) 68rem, 92vw"
								loading="eager"
							/>
						)
					)
				}
			</div>

			<div class="prose project__prose">
				<Content />
			</div>

			{
				link && (
					<p class="project__external">
						<a href={link} rel="noopener noreferrer" target="_blank">
							View the project →
						</a>
					</p>
				)
			}
		</div>
	</main>

	<Footer />
</Base>

<style>
	.project {
		padding-top: var(--s-6);
		padding-bottom: var(--s-section);
	}

	.project__back a {
		text-decoration: none;
	}

	.project__header {
		margin-top: var(--s-7);
		padding-bottom: var(--s-6);
		border-bottom: var(--hairline) solid var(--c-rule);
	}

	.project__title {
		font-size: var(--t-xl);
		max-width: 24ch;
	}

	.project__blurb {
		max-width: var(--measure);
		margin-top: var(--s-4);
		font-size: var(--t-md);
		line-height: var(--lh-snug);
		color: var(--c-ink-muted);
	}

	.project__facts {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-6);
		margin-top: var(--s-6);
	}

	.project__fact dd {
		margin: var(--s-1) 0 0;
		font-size: var(--t-sm);
	}

	.project__media {
		margin-top: var(--s-7);
	}

	.project__image {
		width: 100%;
		border: var(--hairline) solid var(--c-rule);
		border-radius: var(--radius);
	}

	/* Gives the cover loop the same 16:9 frame the embed gets. */
	.project__cover {
		aspect-ratio: 16 / 9;
		width: 100%;
		overflow: hidden;
		background: var(--c-bg-raised);
		border: var(--hairline) solid var(--c-rule);
		border-radius: var(--radius);
	}

	/* Full width, matching the video above it. The global .prose measure
	   (34rem) left the write-up at half the video's width, which read as
	   undersized next to it. */
	.project__prose {
		max-width: none;
		margin-top: var(--s-7);
	}

	.project__external {
		margin-top: var(--s-6);
		font-family: var(--f-mono);
		font-size: var(--t-sm);
	}
</style>
